# ============================================================
# Travel App - Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# NEVER commit your .env file to version control.
# ============================================================

# --- OpenWeatherMap ---
# Get your free key at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# --- Unsplash (Primary Image Source) ---
# Get your free key at: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Pexels (Fallback Image Source) ---
# Get your free key at: https://www.pexels.com/api/
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# --- Google Gemini AI ---
# Get your key at: https://ai.google.dev/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
