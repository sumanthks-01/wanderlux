# ==========================================
# WanderLux — .gitignore
# ==========================================

# --- Environment & Secrets (NEVER commit) ---
.env
.env.local
.env.*.local
.env.production

# --- Dependencies ---
node_modules/

# --- Build Outputs ---
dist/
dist-ssr/
build/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- OS & System ---
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Editor ---
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# --- Vite / Cache ---
*.local
.vite/

.vercel
